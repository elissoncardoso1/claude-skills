{
 "id": "S11",
 "origin": "development repository: tests/skill-tests.md S11 (MCP, unavailable font) + acceptance test D",
 "suite": "cli",
 "kind": "delivery",
 "title": "missing font is detected (manifest, vc_check) and mitigated by an outlined SVG next to the editable file",
 "recipe": {
